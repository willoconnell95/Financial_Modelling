# Backend environment variables — copy to .env and fill in values

# Application
DEBUG=false

# Database (SQLite by default; swap for postgres+asyncpg for production)
DATABASE_URL=sqlite+aiosqlite:///./financial_model.db

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Optional: LLM provider for enhanced NLP command parsing
# LLM_PROVIDER=openai   # local | openai | anthropic
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
