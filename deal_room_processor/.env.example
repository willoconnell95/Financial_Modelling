# ─────────────────────────────────────────────────────────────────────────────
# Deal Room Processor — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude API ───────────────────────────────────────────────────────────────
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SMTP Email (choose one configuration below) ───────────────────────────────

# Gmail (requires a Google App Password — NOT your regular Gmail password)
# Enable 2FA first, then generate an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your-address@gmail.com

# ── Alternative: Outlook / Office 365 ────────────────────────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@outlook.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=your-address@outlook.com

# ── Alternative: Zoho Mail ────────────────────────────────────────────────────
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@zoho.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=your-address@zoho.com

# ── Alternative: SendGrid ─────────────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=your-verified-sender@domain.com

# ── Alternative: Any SSL/TLS provider (port 465) ─────────────────────────────
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_USERNAME=you@yourdomain.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=you@yourdomain.com

# ── Email recipient ───────────────────────────────────────────────────────────
# Who receives the deal summary. Defaults to will@athletic.vc if not set.
EMAIL_RECIPIENT=will@athletic.vc

# ── App settings (optional) ───────────────────────────────────────────────────
# SECRET_KEY=change-me-to-a-random-string
# PORT=5000
# FLASK_DEBUG=false
