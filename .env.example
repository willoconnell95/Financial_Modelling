# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Financial Modelling Platform"
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, zero-config)
DATABASE_URL=sqlite:///./data/financial_modelling.db

# PostgreSQL (production option)
# DATABASE_URL=postgresql://user:password@localhost:5432/financial_modelling

# ── File Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── OpenAI (optional - enables enhanced NLP command parsing) ──────────────────
# Without this, the platform uses built-in rule-based parsing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── CORS ───────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
