# ============================================================
# Athletic VC — Deal Processor  |  Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ── Anthropic / Claude ───────────────────────────────────────
# Your Anthropic API key  (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# ── SMTP Email Delivery ──────────────────────────────────────
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-app-password    ← use a Gmail App Password, NOT your account password
#
# Outlook / Microsoft 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@yourdomain.com
#   SMTP_PASSWORD=your-password
#
# Port 587 uses STARTTLS (recommended).
# Port 465 uses implicit SSL.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER=your-email@gmail.com   # Optional — defaults to SMTP_USERNAME

# ── Flask (optional) ─────────────────────────────────────────
# Set to "true" to enable hot-reload during development
FLASK_DEBUG=false

# Port to run on (default: 5000)
PORT=5000

# Secret key for Flask sessions — change this to a random string
FLASK_SECRET_KEY=change-me-to-a-random-secret
